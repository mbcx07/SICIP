  function getUsuario() {
    try { var s = sessionStorage.getItem('sicip_usuario'); return s ? JSON.parse(s) : null; } catch(e) { return null; }
  }
  
  function getSicipData() { return window.__SICIP_DATA__ || {}; }
  
  // ========== HELPERS DE INYECCIÓN EN LAYOUT ==========
  // Encuentra el contenedor de contenido React (el div main) y le inyecta HTML
  // Sin ocultar el sidebar ni el header
  function getContentContainer() {
    // Buscar el contenedor principal de contenido — el que tiene el ruteo de React
    // Normalmente es un <main> o un div dentro del layout
    var main = document.querySelector('main');
    if (main) return main;
    
    // Fallback: el div dentro del sidebar layout
    var root = document.getElementById('root');
    if (root && root.children.length > 0) {
      // Buscar el contenedor que NO es el nav
      for (var i = 0; i < root.children.length; i++) {
        var child = root.children[i];
        if (child.tagName !== 'NAV' && child.tagName !== 'HEADER' && child.tagName !== 'ASIDE') {
          return child;
        }
      }
    }
    
    return root;
  }
  
  function removeInjectedPanel() {
    var p = document.querySelector('[data-sicip-cr-panel]');
    if (p) p.remove();
    var ph = document.querySelector('[data-sicip-cr-placeholder]');
    if (ph) ph.remove();
  }
  
  function showContent(html) {
    removeInjectedPanel();
    var container = getContentContainer();
    if (!container) return;
    
    // Crear un placeholder para mantener la estructura del layout intacta
    // Ocultar contenido React pero NO el layout
    hideReactContent(container);
    
    var panel = document.createElement('div');
    panel.setAttribute('data-sicip-cr-panel', 'layout');
    panel.innerHTML = html;
    container.appendChild(panel);
  }
  
  function hideReactContent(container) {
    // Ocultar los hijos React (ruteo), pero no afectar el layout padre
    // El sidebar y header viven fuera de este container
    for (var i = 0; i < container.children.length; i++) {
      var child = container.children[i];
      if (!child.hasAttribute('data-sicip-cr-panel')) {
        child.style.display = 'none';
      }
    }
  }
  
  function showReactContent() {
    removeInjectedPanel();
    var container = getContentContainer();
    if (!container) return;
    for (var i = 0; i < container.children.length; i++) {
      var child = container.children[i];
      if (!child.hasAttribute('data-sicip-cr-panel')) {
        child.style.display = '';
      }
    }
  }
  
