  // Funciones Firestore inline para guardado
  async function guardarCuadroFirestore(matricula, data) {
    var FS_PROJECT = 'sicip-bcs';
    var FS_BASE = 'https://firestore.googleapis.com/v1/projects/' + FS_PROJECT + '/databases/(default)/documents';
    
    var path = FS_BASE + '/' + encodeURIComponent('cuadrosReemplazoBase') + '/' + encodeURIComponent(String(matricula));
    var body = toFSDoc(data);
    
    var r = await fetch(path, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }
  
  async function guardarCuadroPreprocesado(matricula, data) {
    var FS_PROJECT = 'sicip-bcs';
    var FS_BASE = 'https://firestore.googleapis.com/v1/projects/' + FS_PROJECT + '/databases/(default)/documents';
    
    var path = FS_BASE + '/' + encodeURIComponent('cuadrosReemplazoPorUsuario') + '/' + encodeURIComponent(String(matricula));
    var body = toFSDoc(data);
    
    var r = await fetch(path, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }
  
