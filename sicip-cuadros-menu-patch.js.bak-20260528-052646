        '<button id="sicip-guardar-y-cerrar" onclick="window.__SICIP_GUARDAR_Y_CERRAR__()" style="background:#005235;color:white;border:none;padding:0.6rem 1.5rem;border-radius:8px;font-size:0.85rem;font-weight:700;cursor:pointer">💾 Guardar y Cerrar</button>' +
        '<button onclick="window.showReactContent();" style="background:#6b7280;color:white;border:none;padding:0.6rem 1.5rem;border-radius:8px;font-size:0.85rem;font-weight:700;cursor:pointer">Cancelar</button>' +
        '<span id="sicip-ultimo-guardado" style="font-size:0.72rem;color:#9ca3af"></span>' +
      '</div>';
    
    container.appendChild(panel);
    
    // === Estado interno ===
    window.__SICIP_ASIGNACION_ACTUAL = {
      jefeMatricula: matricula,
      jefeNombre: nombre,
      jefePuesto: puestoJefe,
      jefeDepto: deptoJefe,
      status: statusActual,
      candidatos: candidatos.slice(0, 3).map(function(c, i) {
        return { posicion: i + 1, matricula: c.matricula || '', nombre: c.nombre || '', descripcion: c.descripcion || '', departamento: c.departamento || '', tipoContrato: c.tipoContrato || '' };
      })
    };
    
    // Rellenar los 3 slots si hay candidatos existentes
    var asig = window.__SICIP_ASIGNACION_ACTUAL;
    for (var si = 0; si < 3; si++) {
      var cdata = asig.candidatos[si];
      if (cdata && cdata.matricula) {
        renderSlotCandidato(si + 1, cdata);
      }
    }
    
    // === Buscar candidato ===
    window.__SICIP_BUSCAR_CANDIDATO__ = function(slot) {
      var input = document.getElementById('slot-search-' + slot);
      var resultsDiv = document.getElementById('slot-results-' + slot);
      if (!input || !resultsDiv) return;
      
      var query = (input.value || '').trim().toLowerCase();
      if (!query) {
        resultsDiv.style.display = 'none';
        return;
      }
      
      var dataLoc = window.__SICIP_DATA__ || {};
      var todosTrabajadores = dataLoc.trabajadores || [];
      
      var matches = todosTrabajadores.filter(function(t) {
        var tNombre = (t.nombre || t.nombres || t.nom || '').toLowerCase();
        var tMat = String(t.matricula || t.id || '');
        return tNombre.indexOf(query) !== -1 || tMat.indexOf(query) !== -1;
      }).slice(0, 10);
      
      if (matches.length === 0) {
        resultsDiv.innerHTML = '<div style="padding:0.75rem;text-align:center;color:#9ca3af;font-size:0.82rem">Sin resultados</div>';
        resultsDiv.style.display = 'block';
        return;
      }
      
      var html = '';
      matches.forEach(function(m) {
        var mNombre = (m.nombre || m.nombres || m.nom || '').replace(/'/g, "\\'");
        var mMat = String(m.matricula || m.id || '');
        var mDesc = m.descripcion || m.puesto || m.puestoDescripcion || '';
        var mDepto = m.departamentoNombre || m.departamento || '';
        var mTipoContrato = m.tipoContrato || '';
        // Escapar comillas simples para el onclick
        var escNombre = (m.nombre || m.nombres || m.nom || '').replace(/'/g, "\\'");
        var escDesc = (m.descripcion || m.puesto || '').replace(/'/g, "\\'");
        var escDepto = (m.departamentoNombre || m.departamento || '').replace(/'/g, "\\'");
        html += '<div style="padding:0.6rem 0.75rem;border-bottom:1px solid #f3f4f6;cursor:pointer;transition:background 0.15s" onclick="window.__SICIP_SELECCIONAR_CANDIDATO__(' + slot + ',\'" + escNombre + "\',\'" + mMat + "\',\'" + escDesc + "\',\'" + escDepto + "\',\'' + (mTipoContrato) + '\')" onmouseenter="this.style.background=\'#f0fdf4\'" onmouseleave="this.style.background=\'\'">' +
          '<div style="font-weight:700;font-size:0.85rem;color:#1a2932">' + escapeHtml(mNombre) + '</div>' +
          '<div style="font-size:0.72rem;color:#6b7280">Mat. ' + escapeHtml(mMat) + ' · ' + escapeHtml(mDesc) + ' · ' + escapeHtml(mDepto) + '</div>' +
        '</div>';
      });
      
      resultsDiv.innerHTML = html;
      resultsDiv.style.display = 'block';
    };
    
    // === Seleccionar candidato ===
    window.__SICIP_SELECCIONAR_CANDIDATO__ = function(slot, nom, mat, desc, depto, tipoContrato) {
      log('Seleccionado slot ' + slot + ': ' + nom + ' (' + mat + ')');
      
      var candidateData = {
        posicion: slot,
        matricula: mat,
        nombre: nom,
        descripcion: desc,
        departamento: depto,
        tipoContrato: tipoContrato || ''
      };
      
      window.__SICIP_ASIGNACION_ACTUAL.candidatos[slot - 1] = candidateData;
      
      // Actualizar UI
      renderSlotCandidato(slot, candidateData);
      
      // Ocultar resultados
      var resultsDiv = document.getElementById('slot-results-' + slot);
      if (resultsDiv) resultsDiv.style.display = 'none';
    };
    
    // === Guardar cuadro ===
    window.__SICIP_GUARDAR_CUADRO__ = async function() {
      var state = window.__SICIP_ASIGNACION_ACTUAL;
      if (!state) return;
      
      var cands = state.candidatos.filter(function(c) { return c && c.matricula; });
      var nuevoStatus = cands.length >= 3 ? 'COMPLETO' : cands.length > 0 ? 'PARCIAL' : 'SIN_ASIGNAR';
      
      var ahora = new Date().toISOString();
      
      var registroBase = {
        jefeMatricula: state.jefeMatricula,
        jefeNombre: state.jefeNombre,
        jefePuestoDescripcion: state.jefePuesto || '',
        jefeDepartamento: state.jefeDepto || '',
        jefeDepartamentoNombre: state.jefeDepto || '',
        candidatos: cands,
        status: nuevoStatus,
        fechaActualizacion: ahora,
        version: (nuevoStatus === 'COMPLETO' ? 1 : 0)
      };
      
      var statusEl = document.getElementById('sicip-asignacion-status');
      var guardarBtn = document.getElementById('sicip-guardar-cuadro');
      var guardarCerrarBtn = document.getElementById('sicip-guardar-y-cerrar');
      
      if (statusEl) {
        statusEl.style.display = 'block';
        statusEl.style.background = '#fffbeb';
        statusEl.style.color = '#92400e';
        statusEl.innerHTML = '⏳ Guardando...';
      }
      if (guardarBtn) guardarBtn.disabled = true;
      if (guardarCerrarBtn) guardarCerrarBtn.disabled = true;
      
      try {
        // Guardar usando las funciones del engine o directamente vía Firestore REST
        var guardado = await guardarCuadroFirestore(state.jefeMatricula, registroBase);
        
        if (guardado) {
          // También generar preprocesado
          try {
            var preprocesados = {
              matricula: state.jefeMatricula,
              jefeNombre: state.jefeNombre,
              jefePuestoDescripcion: state.jefePuesto || '',
              jefeDepartamentoNombre: state.jefeDepto || '',
              localidad: '',
              turno: '',
              status: nuevoStatus,
              candidatos: cands,
              version: Date.now(),
              fechaActualizacion: ahora,
              generadoEn: ahora
            };
            await guardarCuadroPreprocesado(state.jefeMatricula, preprocesados);
          } catch(e2) {
            log('Error guardando preprocesado: ' + e2.message);
          }
          
          // Actualizar cache local
          var cacheKey = 'sicip_cuadros_cache';
          try {
            var cache = JSON.parse(sessionStorage.getItem(cacheKey) || '{}');
            cache[state.jefeMatricula] = registroBase;
            sessionStorage.setItem(cacheKey, JSON.stringify(cache));
          } catch(e3) {}
          
          if (statusEl) {
            statusEl.style.background = '#f0fdf4';
            statusEl.style.color = '#16a34a';
            statusEl.innerHTML = '✅ Cuadro guardado exitosamente — ' + cands.length + '/3 candidatos';
          }
          
          var lastSaved = document.getElementById('sicip-ultimo-guardado');
          if (lastSaved) lastSaved.textContent = 'Último guardado: ' + new Date().toLocaleTimeString('es-MX');
          
          // Refrescar datos globales
          if (window.__SICIP_DATA__ && window.__SICIP_DATA__.cuadros) {
            var updateCuadro = window.__SICIP_DATA__.cuadros.find(function(c) { return String(c.jefeMatricula || c.id) === String(state.jefeMatricula); });
            if (updateCuadro) {
              updateCuadro.status = nuevoStatus;
              updateCuadro.candidatos = cands;
              updateCuadro.fechaActualizacion = ahora;
            } else {
              window.__SICIP_DATA__.cuadros.push(registroBase);
            }
          }
        } else {
          if (statusEl) {
            statusEl.style.background = '#fef2f2';
            statusEl.style.color = '#dc2626';
            statusEl.innerHTML = '❌ Error al guardar: respuesta vacía';
          }
        }
      } catch(e) {
        log('Error guardando: ' + e.message);
        if (statusEl) {
          statusEl.style.background = '#fef2f2';
          statusEl.style.color = '#dc2626';
          statusEl.innerHTML = '❌ Error: ' + escapeHtml(e.message);
        }
      } finally {
        if (guardarBtn) guardarBtn.disabled = false;
        if (guardarCerrarBtn) guardarCerrarBtn.disabled = false;
      }
    };
    
    // Guardar y cerrar
    window.__SICIP_GUARDAR_Y_CERRAR__ = async function() {
      await window.__SICIP_GUARDAR_CUADRO__();
      setTimeout(function() {
        window.showReactContent();
      }, 800);
    };
    
    log('Panel de asignación forzosa creado para ' + nombre);
  }
  
