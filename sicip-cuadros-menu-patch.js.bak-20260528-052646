  // Helper: quitar candidato de un slot
  function quitarCandidato(slot) {
    var state = window.__SICIP_ASIGNACION_ACTUAL;
    if (!state) return;
    state.candidatos[slot - 1] = { posicion: slot, matricula: '', nombre: '', descripcion: '', departamento: '', tipoContrato: '' };
